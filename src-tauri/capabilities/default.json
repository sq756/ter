{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "shell:default",
    "log:default",
    "webview:allow-create-webview",
    "webview:allow-navigate",
    "webview:allow-javascript-eval",
    "window:allow-create-window",
    "window:allow-set-size",
    "window:allow-set-position"
  ]
}
